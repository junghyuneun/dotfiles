{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "shell_integration": true,
  "iterm_features": ["current_dir", "prompt_mark", "remote_host"],
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "leading_diamond": "\u250f",
      "trailing_diamond": "\ue0b4",
      "segments": [
        {
          "foreground": "black",
          "background": "yellow",
          "style": "diamond",
          "template": "{{ if .WSL }}WSL at {{ end }} {{.Icon}} ",
          "type": "os"
        },
        {
          "background_templates": ["{{ if gt .Code 0 }}red{{ end }}"],
          "style": "plain",
          "template": " {{ if gt .Code 0 }}<black></> {{ end }}",
          "type": "status"
        },
        {
          "background": "black",
          "foreground": "lightWhite",
          "style": "plain",
          "template": " {{ .UserName }} ",
          "type": "session"
        },
        {
          "type": "ipify",
          "style": "plain",
          "foreground": "black",
          "background": "yellow",
          "template": " {{ .IP }} ",
          "options": {
            "http_timeout": 1000
          },
          "cache": {
            "duration": "15m",
            "strategy": "session"
          }
        },
        {
          "background": "blue",
          "foreground": "black",
          "options": {
            "time_format": "\ue641 15:04:05 | \uf073 2 Jan, Mon"
          },
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }} ",
          "type": "time"
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "type": "prompt",
      "leading_diamond": "\u2523",
      "trailing_diamond": "\ue0b4",
      "overflow": "break",
      "segments": [
        {
          "background": "green",
          "foreground": "black",
          "style": "diamond",
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "darkGray",
          "foreground": "lightWhite",
          "options": {
            "folder_icon": " \uf07c ",
            "folder_separator_icon": "/",
            "home_icon": "\ueb06 ~",
            "style": "agnoster_short",
            "max_depth": 3,
            "display_root": true
          },
          "template": " {{ .Path }} ",
          "type": "path",
          "style": "diamond"
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "type": "prompt",
      "leading_diamond": "\u2514",
      "trailing_diamond": "\ue0b0",
      "segments": [
        {
          "background": "black",
          "foreground": "lightWhite",
          "options": {
            "fetch_package_manager": true
          },
          "style": "diamond",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "blue",
          "foreground": "black",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "type": "python"
        },
        {
          "style": "diamond",
          "background": "magenta",
          "foreground": "black",
          "type": "session",
          "template": "{{ if .Root }} 󰐤 󰐣 󱅿 {{ else }}   󰻳 {{ end }}"
        }
      ]
    }
  ],
  "version": 3
}
